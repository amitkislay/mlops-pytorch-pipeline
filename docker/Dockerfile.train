# syntax=docker/dockerfile:1

FROM python:3.14-slim AS builder

WORKDIR /build

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY requirements/train.txt ./requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip wheel \
       --only-binary=:all: \
       --wheel-dir=/wheels \
       -r requirements.txt


FROM python:3.14-slim AS training

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TRAINING_CONFIG=/app/configs/training_config.yaml

COPY --from=builder /wheels /wheels
COPY requirements/train.txt /tmp/requirements.txt

RUN python -m pip install \
       --no-index \
       --find-links=/wheels \
       -r /tmp/requirements.txt \
    && rm -rf /wheels /tmp/requirements.txt

COPY src/ ./src/

COPY configs/training_config.docker.yaml \
     ./configs/training_config.yaml

RUN mkdir -p /app/data /app/checkpoints

ENTRYPOINT ["python", "src/train.py"]

CMD ["--config", "/app/configs/training_config.yaml"]